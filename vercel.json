{
  "framework": "nextjs",
  "buildCommand": "next build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "regions": ["gru1"],
  "env": {
    "NEXT_PUBLIC_APP_URL": "https://govhealth.techealth.com.br"
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "gov-health.vercel.app" }],
      "destination": "https://govhealth.techealth.com.br/:path*",
      "permanent": false
    }
  ],
  "crons": []
}
