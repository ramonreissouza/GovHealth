{
  "framework": "nextjs",
  "buildCommand": "next build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "regions": ["gru1"],
  "env": {
    "NEXT_PUBLIC_APP_URL": "https://gov-health.vercel.app"
  },
  "crons": [
    {
      "path": "/api/cron/sync-pncp",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/sync-transferegov",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/sync-emendas",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/trial-reminders",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/alertas-email",
      "schedule": "0 11 * * *"
    }
  ]
}
