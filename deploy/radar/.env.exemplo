# deploy/radar/.env.exemplo — copie para `.env` NA VPS e preencha.
#
# O `.env` de verdade NUNCA entra no git nem na imagem (ver .dockerignore na raiz).
# Na VPS: `chmod 600 .env`, dono root. Este arquivo decifra a sessão gov.br de TODOS
# os clientes conectados — é o segredo mais sensível do produto.

# Postgres de produção (o mesmo que a aplicação usa).
DATABASE_URL=postgresql://usuario:senha@host:6432/banco?sslmode=require

# Cofre AES-256-GCM das sessões. 32 bytes em hex — O MESMO valor que está na Vercel:
# sessão cifrada aqui e lida lá, ou o worker não abre nada.
#   openssl rand -hex 32
RADAR_CRED_KEY=

# Segredo entre a aplicação e este serviço. Precisa bater com RADAR_CONNECT_TOKEN na
# Vercel. Nunca chega ao navegador do cliente: quem o injeta é a rota do Next.
#   openssl rand -hex 32
RADAR_CONNECT_TOKEN=

# Endereço PÚBLICO deste serviço — o que vai dentro do iframe.
#
# TEM de ser https e TEM de ser o hostname real: é com ele que o serviço reescreve o
# endereço do websocket cravado no HTML do player. Errado aqui, o player carrega e
# fica "Session not connected", sem erro em lugar nenhum.
RADAR_PUBLIC_URL=https://radar.EXEMPLO.com.br
