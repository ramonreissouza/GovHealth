# deploy/app/.env.exemplo — lista canônica das variáveis (e o porquê de cada
# uma). NÃO copie para `.env` nesta pasta — o docker-compose.yml não lê mais
# um `.env` local: lê o AMBIENTE DO SHELL (ver `x-app-env` no topo daquele
# arquivo), no mesmo padrão do outro projeto desta VPS (tecsuply).
#
# Para usar: pegue este conteúdo, troque cada `KEY=valor` por
# `export KEY=valor`, preencha e salve em `~/govhealth-secrets.env` (fora do
# repositório) — e dê `source` nele antes de qualquer `docker compose`:
#
#   source ~/govhealth-secrets.env
#   cd ~/govhealth/deploy/app && docker compose up -d --wait --wait-timeout 120 app worker
#
# Não copie o `.env.local` da máquina de desenvolvimento inteiro para lá sem
# revisar: ele aponta para o banco ANTIGO.
#
# ┌ LEIA ANTES ─────────────────────────────────────────────────────────────────┐
# │ As variáveis marcadas BUILD são gravadas no bundle durante `docker compose  │
# │ build`. Alterá-las aqui depois NÃO muda nada até reconstruir a imagem.      │
# └────────────────────────────────────────────────────────────────────────────┘

# ── banco ────────────────────────────────────────────────────────────────────
# O compose monta o DATABASE_URL da app a partir destas três, apontando para o
# serviço `db`. Não defina DATABASE_URL aqui: o compose sobrescreve de propósito,
# justamente para um .env copiado da outra máquina não apontar para o banco antigo.
POSTGRES_USER=govhealth
POSTGRES_PASSWORD=
POSTGRES_DB=govhealth

# ── identidade da instalação (BUILD) ─────────────────────────────────────────
# URL pública, com https e SEM barra no fim. Entra no CORS das rotas /api e nos
# links dos e-mails — errado aqui, os e-mails saem com link quebrado e a origem do
# CORS não bate.
NEXT_PUBLIC_APP_URL=https://app.EXEMPLO.com.br
SITE_URL=https://app.EXEMPLO.com.br
NEXT_PUBLIC_CONTATO_EMAIL=contato@EXEMPLO.com.br

# ── autenticação ─────────────────────────────────────────────────────────────
# NEXTAUTH_SECRET assina os cookies de sessão: mudar o valor derruba TODO mundo.
# Traga o mesmo valor que está em produção hoje se quiser manter as sessões vivas.
#   openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://app.EXEMPLO.com.br
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sessão única por conta (kill-switch; 'on' liga).
AUTH_SESSAO_UNICA=

# ── Radar ────────────────────────────────────────────────────────────────────
# RADAR_CRED_KEY decifra a sessão gov.br de TODOS os clientes conectados. É o
# segredo mais sensível do produto e tem de ser o MESMO valor de hoje, ou as
# credenciais já guardadas viram lixo ilegível.
RADAR_CRED_KEY=
RADAR_CONNECT_URL=
RADAR_CONNECT_TOKEN=
# BUILD — origem do iframe do navegador hospedado. Entra na CSP em tempo de build.
RADAR_EMBED_ORIGIN=

# ── cron ─────────────────────────────────────────────────────────────────────
# Protege as rotas /api/cron/*. Sem ele as rotas respondem 401 — que é o certo.
CRON_SECRET=

# ── e-mail ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── IA (opcional; sem chave o Copiloto fica desligado) ───────────────────────
ZAI_API_KEY=
ZAI_BASE_URL=
ZAI_MODEL=
# BUILD — 'on' mostra o Copiloto na interface.
NEXT_PUBLIC_IA_HABILITADA=

# ── Stripe (opcional; inerte sem as chaves) ──────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENCIAL=
STRIPE_PRICE_PRO=
STRIPE_PRICE_EMPRESA=
# BUILD
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── fontes externas (opcionais) ──────────────────────────────────────────────
PORTAL_TRANSPARENCIA_API_KEY=
SERASA_API_KEY=
SERASA_API_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── segurança admin (opcional) ────────────────────────────────────────────────
# Camada extra no acesso master (src/lib/admin-guard.ts): se vazio, o acesso
# master vale só pelo role='master' do JWT, sem checar e-mail. Não é obrigatório
# — é defesa em profundidade.
ADMIN_EMAIL=

# ── 2FA por e-mail (opcional; kill-switch) ───────────────────────────────────
# 'on' liga (src/lib/seguranca.ts). Padrão é DESLIGADO — não é preciso setar
# nada para manter o comportamento de hoje.
AUTH_2FA=

# ── Jira — backlog espelhado (opcional) ──────────────────────────────────────
# src/lib/jira.ts: sem as 4 primeiras, toda função vira no-op — nada quebra,
# só o feedback não sincroniza com o Jira. JIRA_ISSUE_TYPE tem fallback 'Task'.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_ISSUE_TYPE=

# ── bases de fontes públicas (opcionais; têm fallback no código) ────────────
# Só preencha para apontar a um endpoint diferente do padrão oficial.
PNCP_BASE_URL=
PNCP_API_BASE=
CNES_BASE_URL=
COMPRASGOV_DADOS_ABERTOS_BASE=

# Radar — Integra Compras (contrato Serpro). Veja docs/radar-comprasgov-ativacao.md.
# Só liga com contrato/chaves válidos; 200, 206 e 404 são tarifados pelo Serpro.
RADAR_COMPRASGOV_ENABLED=0
RADAR_COMPRASGOV_AMBIENTE=producao
RADAR_COMPRASGOV_INTERVAL_SECONDS=300
RADAR_COMPRASGOV_MAX_REQUESTS=20
SERPRO_CONSUMER_KEY=
SERPRO_CONSUMER_SECRET=
# Coletor gratuito: intervalo após cada passada (mínimo 300 segundos).
RADAR_PUBLICO_INTERVAL_SECONDS=300
