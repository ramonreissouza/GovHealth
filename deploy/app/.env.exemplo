# deploy/app/.env.exemplo — copie para `.env` NA VPS e preencha.
#
#   cp .env.exemplo .env && chmod 600 .env
#
# O `.env` de verdade nunca entra no git nem na imagem (ver .gitignore da raiz e o
# Dockerfile.dockerignore ao lado). Não copie o `.env.local` da máquina de
# desenvolvimento inteiro para cá sem revisar: ele aponta para o banco ANTIGO.
#
# ┌ LEIA ANTES ─────────────────────────────────────────────────────────────────┐
# │ As variáveis marcadas BUILD são gravadas no bundle durante `docker compose  │
# │ build`. Alterá-las aqui depois NÃO muda nada até reconstruir a imagem.      │
# └────────────────────────────────────────────────────────────────────────────┘

# ── banco ────────────────────────────────────────────────────────────────────
# O compose monta o DATABASE_URL da app a partir destas três, apontando para o
# serviço `db`. Não defina DATABASE_URL aqui: o compose sobrescreve de propósito,
# justamente para um .env copiado da outra máquina não apontar para o banco antigo.
POSTGRES_USER=govhealth
POSTGRES_PASSWORD=
POSTGRES_DB=govhealth

# ── identidade da instalação (BUILD) ─────────────────────────────────────────
# URL pública, com https e SEM barra no fim. Entra no CORS das rotas /api e nos
# links dos e-mails — errado aqui, os e-mails saem com link quebrado e a origem do
# CORS não bate.
NEXT_PUBLIC_APP_URL=https://app.EXEMPLO.com.br
SITE_URL=https://app.EXEMPLO.com.br
NEXT_PUBLIC_CONTATO_EMAIL=contato@EXEMPLO.com.br

# ── autenticação ─────────────────────────────────────────────────────────────
# NEXTAUTH_SECRET assina os cookies de sessão: mudar o valor derruba TODO mundo.
# Traga o mesmo valor que está em produção hoje se quiser manter as sessões vivas.
#   openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://app.EXEMPLO.com.br
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sessão única por conta (kill-switch; 'on' liga).
AUTH_SESSAO_UNICA=

# ── Radar ────────────────────────────────────────────────────────────────────
# RADAR_CRED_KEY decifra a sessão gov.br de TODOS os clientes conectados. É o
# segredo mais sensível do produto e tem de ser o MESMO valor de hoje, ou as
# credenciais já guardadas viram lixo ilegível.
RADAR_CRED_KEY=
RADAR_CONNECT_URL=
RADAR_CONNECT_TOKEN=
# BUILD — origem do iframe do navegador hospedado. Entra na CSP em tempo de build.
RADAR_EMBED_ORIGIN=

# ── cron ─────────────────────────────────────────────────────────────────────
# Protege as rotas /api/cron/*. Sem ele as rotas respondem 401 — que é o certo.
CRON_SECRET=

# ── e-mail ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── IA (opcional; sem chave o Copiloto fica desligado) ───────────────────────
ZAI_API_KEY=
ZAI_BASE_URL=
ZAI_MODEL=
# BUILD — 'on' mostra o Copiloto na interface.
NEXT_PUBLIC_IA_HABILITADA=

# ── Stripe (opcional; inerte sem as chaves) ──────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENCIAL=
STRIPE_PRICE_PRO=
STRIPE_PRICE_EMPRESA=
# BUILD
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── fontes externas (opcionais) ──────────────────────────────────────────────
PORTAL_TRANSPARENCIA_API_KEY=
SERASA_API_KEY=
SERASA_API_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
