# ============================================================
# GovHealth AI — Variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores
# ============================================================

# --- Portal da Transparência (TransfereGov / Convênios) ---
# Cadastro gratuito em: https://portaldatransparencia.gov.br/api-de-dados
PORTAL_TRANSPARENCIA_API_KEY=sua_chave_aqui

# --- PNCP (Portal Nacional de Contratações Públicas) ---
# API pública — sem autenticação necessária para leitura
PNCP_BASE_URL=https://pncp.gov.br/api/consulta/v1
PNCP_API_BASE=https://pncp.gov.br/api/pncp/v1

# --- IA (Copiloto e Copiloto de Edital) — provedor Z.ai / GLM ---
# Chave da API em: https://z.ai (Dashboard → API Keys). Modelo padrão glm-4.7-flash (grátis).
ZAI_API_KEY=
# Liga as telas/rotas de IA (client-safe). Deixe "on" para habilitar.
NEXT_PUBLIC_IA_HABILITADA=on
# (Opcional) trocar o modelo ou o endpoint
# ZAI_MODEL=glm-4.5-flash
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# --- Mapbox (Mapa interativo) ---
# Obtenha em: https://account.mapbox.com/access-tokens
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1...

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=gere_um_segredo_forte_aqui
NEXTAUTH_URL=http://localhost:3000
NODE_ENV=development

# --- Auth — Google OAuth (opcional) ---
# Crie em: https://console.developers.google.com/
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=seu_google_client_id
GOOGLE_CLIENT_SECRET=seu_google_client_secret

# --- Auth — Credenciais demo (fallback) ---
AUTH_DEMO_EMAIL=demo@govhealth.ai
AUTH_DEMO_PASSWORD=demo123

# --- Email — Resend (notificações de alertas) ---
# Cadastre-se em: https://resend.com (plano gratuito: 3.000 emails/mês)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=alertas@seudominio.com

# --- Pagamentos — Stripe (assinaturas / cartão recorrente) ---
# Chaves em: https://dashboard.stripe.com/apikeys (use as de TESTE para validar)
STRIPE_SECRET_KEY=sk_test_...
# Chave PUBLICÁVEL (usada no navegador p/ o checkout embutido). Começa com pk_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Segredo do endpoint de webhook (Dashboard → Developers → Webhooks → seu endpoint)
# Para testar local: `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=whsec_...
# (Opcional) Price IDs recorrentes já criados no Stripe. Se omitir, o preço é
# criado inline (BRL, mensal) a partir de src/lib/planos.ts. Gere com: npm run stripe:setup
STRIPE_PRICE_ESSENCIAL=price_...
STRIPE_PRICE_PRO=price_...

# --- Radar (monitoramento de chat de licitações) ---
# Chave do COFRE de credenciais de portal (AES-256-GCM). 32 bytes em hex (64 chars).
# Gere com: openssl rand -hex 32  (ou: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# SERVER-ONLY — nunca prefixe com NEXT_PUBLIC_. Sem ela, o cadastro de credenciais é recusado.
RADAR_CRED_KEY=
# Worker de captura (roda fora da Vercel, no Task Scheduler): npm run radar:sync
# Antes do primeiro uso real: npx playwright install chromium
#
# --- Radar: navegador HOSPEDADO (steel-browser) para conectar sem terminal ---
# 1) docker compose -f docker-compose.radar.yml up -d   (sobe o steel)
# 2) npm run radar:browser-service                       (serviço no host/VPS)
# URL da API do steel (self-host). Local: http://localhost:3100
RADAR_STEEL_URL=http://localhost:3100
# Endpoint CDP do steel para o Playwright conectar (connectOverCDP). Local: http://localhost:9223
RADAR_STEEL_CDP=http://localhost:9223
# (Opcional) Template da URL de live view para o iframe; {id} = id da sessão.
# Se vazio, usa o campo devUrl/sessionViewerUrl que o steel devolver ao criar a sessão.
RADAR_STEEL_EMBED_TEMPLATE=
# Serviço de navegador (browser-service.mjs). O Next faz proxy para cá.
RADAR_CONNECT_URL=http://localhost:3200
# Token compartilhado entre o Next (proxy) e o browser-service. Gere um aleatório.
RADAR_CONNECT_TOKEN=

# --- Cache (Redis — opcional para produção) ---
# REDIS_URL=redis://localhost:6379
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...
